{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/camellia-computing/.github/blob/main/schemas/repository-policies.schema.json",
  "title": "Camellia audited repository policies",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_revision",
    "organization",
    "last_reviewed_on",
    "repositories"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "policy_revision": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"
    },
    "organization": {
      "const": "camellia-computing"
    },
    "last_reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "visibility",
          "required_status_checks",
          "required_paths",
          "release_review_team",
          "release_deployment_policies"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "visibility": {
            "enum": [
              "public",
              "private"
            ]
          },
          "required_status_checks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "release_review_team": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "release_deployment_policies": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "branch",
                    "tag"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
