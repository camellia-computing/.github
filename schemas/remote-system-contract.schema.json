{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camellia-computing.github.io/schemas/remote-system-contract.schema.json",
  "title": "Camellia Remote system contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "contract_revision",
    "organization",
    "logical_repositories",
    "service_repositories",
    "required_images",
    "required_artifacts",
    "scenarios",
    "modes",
    "artifact_policy",
    "isolation"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "contract_revision": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"},
    "organization": {"const": "camellia-computing"},
    "logical_repositories": {"type": "array", "const": ["remote-client", "remote-management", "remote-protocol", "remote-server"]},
    "service_repositories": {"type": "array", "const": ["remote-management", "remote-server"]},
    "required_images": {"type": "array", "const": ["remote-management", "remote-server"]},
    "required_artifacts": {"type": "array", "const": ["remote-client-web", "remote-client-controller", "remote-server-image", "remote-management-image"]},
    "scenarios": {"type": "array", "const": ["auth-device-verification", "direct-session", "forced-relay-session", "first-frame-input", "file-clipboard-audit", "reconnect-shutdown"]},
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["smoke", "exhaustive"],
      "properties": {
        "smoke": {"$ref": "#/$defs/mode"},
        "exhaustive": {"$ref": "#/$defs/mode"}
      }
    },
    "artifact_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retention_days", "max_manifest_bytes", "max_evidence_bytes", "forbidden_field_tokens"],
      "properties": {
        "retention_days": {"const": 7},
        "max_manifest_bytes": {"const": 262144},
        "max_evidence_bytes": {"const": 4194304},
        "forbidden_field_tokens": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "max_name_length"],
      "properties": {
        "required": {"type": "array", "const": ["compose_project", "network", "volume_prefix", "credential_namespace", "port_range"]},
        "max_name_length": {"const": 63}
      }
    }
  },
  "$defs": {
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_duration_seconds", "required_scenarios"],
      "properties": {
        "max_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 7200},
        "required_scenarios": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
