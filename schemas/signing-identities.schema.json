{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/signing-identities.schema.json",
  "title": "Artifact signing policy registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_revision",
    "organization",
    "last_reviewed_on",
    "trust_priority",
    "identities"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 2
    },
    "registry_revision": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"
    },
    "organization": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
    },
    "last_reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "trust_priority": {
      "const": [
        "public-trust",
        "private-trust",
        "platform-key",
        "ad-hoc",
        "unsigned"
      ]
    },
    "identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "platform",
          "consumers",
          "allowed_outcomes",
          "formal_unsigned_allowed",
          "credential_groups",
          "verification_adapter",
          "rotation_max_days",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "platform": {
            "enum": [
              "windows",
              "macos",
              "linux",
              "android",
              "ios"
            ]
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "nexus-client",
                "remote-client"
              ]
            }
          },
          "allowed_outcomes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "public-trust",
                "private-trust",
                "platform-key",
                "ad-hoc",
                "unsigned"
              ]
            }
          },
          "formal_unsigned_allowed": {
            "type": "boolean"
          },
          "credential_groups": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "secret_names",
                "variable_names"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "secret_names": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]*$"
                  }
                },
                "variable_names": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]*$"
                  }
                }
              }
            }
          },
          "verification_adapter": {
            "enum": [
              "authenticode",
              "apple-codesign",
              "apple-mobile-codesign",
              "android-apksigner",
              "openpgp"
            ]
          },
          "rotation_max_days": {
            "type": "integer",
            "minimum": 0,
            "maximum": 90
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
