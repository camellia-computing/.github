{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/camellia-computing/.github/blob/main/schemas/signing-identities.schema.json",
  "title": "Camellia signing identity registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_revision",
    "organization",
    "last_reviewed_on",
    "identities"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "registry_revision": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"
    },
    "organization": {
      "const": "camellia-computing"
    },
    "last_reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "platform",
          "consumers",
          "state",
          "distribution_trust",
          "secret_names",
          "variable_names",
          "public_identity",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "platform": {
            "enum": [
              "windows",
              "macos",
              "linux",
              "android",
              "ios"
            ]
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "nexus",
                "remote-client"
              ]
            }
          },
          "state": {
            "enum": [
              "not-configured",
              "configured-unregistered",
              "active",
              "retiring",
              "revoked"
            ]
          },
          "distribution_trust": {
            "enum": [
              "public-trust",
              "private-trust",
              "platform-key",
              "unresolved"
            ]
          },
          "secret_names": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          },
          "variable_names": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          },
          "public_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "value",
              "not_after",
              "native_reference"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "x509-sha256",
                  "openpgp-fingerprint"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "not_after": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "native_reference": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "value"
                    ],
                    "properties": {
                      "kind": {
                        "const": "x509-sha1-thumbprint"
                      },
                      "value": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
