{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/release-evidence.schema.json",
  "title": "Immutable release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "version",
    "source",
    "release_kind",
    "generated_at",
    "policy",
    "dependencies",
    "files",
    "images"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository": {
      "$ref": "#/$defs/logicalId"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "ref",
        "validation_run_id"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "validation_run_id": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "release_kind": {
      "enum": [
        "candidate",
        "formal"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_policy_revision",
        "signing_registry_revision",
        "exceptions"
      ],
      "properties": {
        "repository_policy_revision": {
          "$ref": "#/$defs/revision"
        },
        "signing_registry_revision": {
          "$ref": "#/$defs/revision"
        },
        "exceptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/exception"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "files": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "images": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/image"
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "files": {
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "images": {
          "minItems": 1
        }
      }
    }
  ],
  "$defs": {
    "logicalId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:\\.[0-9A-Za-z]+)*)?$"
    },
    "revision": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidenceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "expires_on",
        "reason",
        "compensating_control",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/logicalId"
        },
        "owner": {
          "$ref": "#/$defs/logicalId"
        },
        "expires_on": {
          "type": "string",
          "format": "date"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "compensating_control": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "version",
        "relation",
        "evidence"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/logicalId"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "version": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/semver"
            }
          ]
        },
        "relation": {
          "enum": [
            "builds-from",
            "bundles",
            "compatible-with"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "verification",
        "verifier",
        "timestamp",
        "distribution",
        "evidence"
      ],
      "properties": {
        "category": {
          "enum": [
            "public-trust",
            "private-trust",
            "platform-key",
            "ad-hoc",
            "unsigned",
            "not-applicable"
          ]
        },
        "verification": {
          "enum": [
            "verified",
            "not-present",
            "not-applicable"
          ]
        },
        "verifier": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "enum": [
            "verified",
            "missing",
            "not-applicable"
          ]
        },
        "distribution": {
          "enum": [
            "installable",
            "restricted",
            "re-signing-input",
            "source-only",
            "not-applicable"
          ]
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "size_bytes",
        "platform",
        "architecture",
        "sbom",
        "provenance",
        "signing"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "platform": {
          "enum": [
            "android",
            "ios",
            "linux",
            "macos",
            "source",
            "web",
            "windows"
          ]
        },
        "architecture": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "sbom": {
          "$ref": "#/$defs/evidenceFile"
        },
        "provenance": {
          "$ref": "#/$defs/evidenceFile"
        },
        "signing": {
          "$ref": "#/$defs/signing"
        }
      }
    },
    "imagePlatform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "architecture",
        "digest"
      ],
      "properties": {
        "platform": {
          "const": "linux"
        },
        "architecture": {
          "enum": [
            "amd64",
            "arm64"
          ]
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "imageSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism",
        "verification",
        "identity",
        "issuer",
        "evidence"
      ],
      "properties": {
        "mechanism": {
          "const": "keyless-cosign"
        },
        "verification": {
          "const": "verified"
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "registryPublication": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "status",
            "repository",
            "digest",
            "aliases",
            "signature",
            "readback"
          ],
          "properties": {
            "name": {
              "enum": [
                "dockerhub",
                "ghcr"
              ]
            },
            "status": {
              "const": "published"
            },
            "repository": {
              "type": "string",
              "pattern": "^[a-z0-9.-]+(?::[0-9]+)?/[a-z0-9]+(?:[._/-][a-z0-9]+)*$"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            },
            "aliases": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "signature": {
              "$ref": "#/$defs/imageSignature"
            },
            "readback": {
              "const": "verified"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "status",
            "reason"
          ],
          "properties": {
            "name": {
              "enum": [
                "dockerhub",
                "ghcr"
              ]
            },
            "status": {
              "const": "skipped"
            },
            "reason": {
              "enum": [
                "candidate-only",
                "not-configured"
              ]
            }
          }
        }
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "digest",
        "platforms",
        "sbom",
        "provenance",
        "registries"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/logicalId"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/imagePlatform"
          }
        },
        "sbom": {
          "$ref": "#/$defs/evidenceFile"
        },
        "provenance": {
          "$ref": "#/$defs/evidenceFile"
        },
        "registries": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/registryPublication"
          }
        }
      }
    }
  }
}
