{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/release-evidence.schema.json",
  "title": "Immutable release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "version",
    "source",
    "release_kind",
    "generated_at",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:\\.[0-9A-Za-z]+)*)?$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "ref"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "release_kind": {
      "enum": [
        "candidate",
        "formal"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256",
          "size_bytes",
          "platform",
          "architecture",
          "sbom",
          "provenance",
          "signing"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "platform": {
            "enum": [
              "android",
              "ios",
              "linux",
              "macos",
              "source",
              "windows"
            ]
          },
          "architecture": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "sbom": {
            "$ref": "#/$defs/evidenceFile"
          },
          "provenance": {
            "$ref": "#/$defs/evidenceFile"
          },
          "signing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "verification",
              "verifier",
              "timestamp",
              "distribution",
              "evidence"
            ],
            "properties": {
              "category": {
                "enum": [
                  "public-trust",
                  "private-trust",
                  "platform-key",
                  "ad-hoc",
                  "unsigned"
                ]
              },
              "verification": {
                "enum": [
                  "verified",
                  "not-present"
                ]
              },
              "verifier": {
                "type": "string",
                "minLength": 1
              },
              "timestamp": {
                "enum": [
                  "verified",
                  "missing",
                  "not-applicable"
                ]
              },
              "distribution": {
                "enum": [
                  "public",
                  "private",
                  "restricted",
                  "source-only"
                ]
              },
              "evidence": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "evidenceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
