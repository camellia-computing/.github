{
  "$schema": "../schemas/signing-identities.schema.json",
  "schema_version": 2,
  "registry_revision": "2026-07-29.1",
  "organization": "camellia-computing",
  "last_reviewed_on": "2026-07-29",
  "trust_priority": [
    "public-trust",
    "private-trust",
    "platform-key",
    "ad-hoc",
    "unsigned"
  ],
  "identities": [
    {
      "id": "desktop-linux-openpgp",
      "platform": "linux",
      "consumers": [
        "nexus-client",
        "remote-client"
      ],
      "allowed_outcomes": [
        "platform-key",
        "unsigned"
      ],
      "formal_unsigned_allowed": true,
      "credential_groups": [
        {
          "id": "primary",
          "secret_names": [
            "LINUX_GPG_PASSPHRASE",
            "LINUX_GPG_PRIVATE_KEY"
          ],
          "variable_names": [
            "LINUX_GPG_FINGERPRINT"
          ]
        }
      ],
      "verification_adapter": "openpgp",
      "rotation_max_days": 30,
      "note": "Detached signatures are verified from the downloaded artifact; the configured fingerprint is only an expected-identity constraint."
    },
    {
      "id": "desktop-macos-publisher",
      "platform": "macos",
      "consumers": [
        "nexus-client",
        "remote-client"
      ],
      "allowed_outcomes": [
        "public-trust",
        "private-trust",
        "ad-hoc",
        "unsigned"
      ],
      "formal_unsigned_allowed": true,
      "credential_groups": [
        {
          "id": "primary",
          "secret_names": [
            "APPLE_API_PRIVATE_KEY",
            "APPLE_CERTIFICATE",
            "APPLE_CERTIFICATE_PASSWORD"
          ],
          "variable_names": [
            "APPLE_API_ISSUER",
            "APPLE_API_KEY",
            "APPLE_SIGNING_CERTIFICATE_SHA256",
            "APPLE_SIGNING_IDENTITY"
          ]
        },
        {
          "id": "secondary",
          "secret_names": [
            "APPLE_SECONDARY_API_PRIVATE_KEY",
            "APPLE_SECONDARY_CERTIFICATE",
            "APPLE_SECONDARY_CERTIFICATE_PASSWORD"
          ],
          "variable_names": [
            "APPLE_SECONDARY_API_ISSUER",
            "APPLE_SECONDARY_API_KEY",
            "APPLE_SECONDARY_SIGNING_CERTIFICATE_SHA256",
            "APPLE_SECONDARY_SIGNING_IDENTITY"
          ]
        }
      ],
      "verification_adapter": "apple-codesign",
      "rotation_max_days": 30,
      "note": "Code signing, Gatekeeper assessment and notarization are evaluated independently from the final downloaded bytes."
    },
    {
      "id": "desktop-windows-publisher",
      "platform": "windows",
      "consumers": [
        "nexus-client",
        "remote-client"
      ],
      "allowed_outcomes": [
        "public-trust",
        "private-trust",
        "unsigned"
      ],
      "formal_unsigned_allowed": true,
      "credential_groups": [
        {
          "id": "primary",
          "secret_names": [
            "WINDOWS_CODESIGN_PFX_BASE64",
            "WINDOWS_CODESIGN_PFX_PASSWORD"
          ],
          "variable_names": [
            "WINDOWS_CODESIGN_CERTIFICATE_SHA256",
            "WINDOWS_CODESIGN_CERTIFICATE_THUMBPRINT",
            "WINDOWS_TIMESTAMP_URL"
          ]
        },
        {
          "id": "secondary",
          "secret_names": [
            "WINDOWS_SECONDARY_CODESIGN_PFX_BASE64",
            "WINDOWS_SECONDARY_CODESIGN_PFX_PASSWORD"
          ],
          "variable_names": [
            "WINDOWS_SECONDARY_CODESIGN_CERTIFICATE_SHA256",
            "WINDOWS_SECONDARY_CODESIGN_CERTIFICATE_THUMBPRINT",
            "WINDOWS_SECONDARY_TIMESTAMP_URL"
          ]
        }
      ],
      "verification_adapter": "authenticode",
      "rotation_max_days": 30,
      "note": "Authenticode trust is derived from native verification; a configured trust label cannot promote an untrusted certificate."
    },
    {
      "id": "remote-android-update",
      "platform": "android",
      "consumers": [
        "remote-client"
      ],
      "allowed_outcomes": [
        "platform-key",
        "unsigned"
      ],
      "formal_unsigned_allowed": true,
      "credential_groups": [
        {
          "id": "primary",
          "secret_names": [
            "ANDROID_ALIAS",
            "ANDROID_KEY_PASSWORD",
            "ANDROID_KEY_STORE_PASSWORD",
            "ANDROID_SIGNING_KEY"
          ],
          "variable_names": [
            "ANDROID_SIGNING_CERTIFICATE_SHA256"
          ]
        }
      ],
      "verification_adapter": "android-apksigner",
      "rotation_max_days": 0,
      "note": "The application update identity is stable; replacement requires a platform-supported signing lineage rather than an ordinary overlap."
    },
    {
      "id": "remote-ios-distribution",
      "platform": "ios",
      "consumers": [
        "remote-client"
      ],
      "allowed_outcomes": [
        "platform-key",
        "ad-hoc",
        "unsigned"
      ],
      "formal_unsigned_allowed": true,
      "credential_groups": [
        {
          "id": "primary",
          "secret_names": [
            "IOS_CERTIFICATE_BASE64",
            "IOS_CERTIFICATE_PASSWORD",
            "IOS_PROVISIONING_PROFILE_BASE64"
